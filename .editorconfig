# https://EditorConfig.org

# top-most EditorConfig file
root = true

# global formatting
[*]
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space
trim_trailing_whitespace = true

# Set default charset for js and python files
[**.{js,py}]
charset = utf-8

# 2 space indentation
[{**.{js,jsx,json,yml,yaml},.eslintrc}]
indent_size = 2
